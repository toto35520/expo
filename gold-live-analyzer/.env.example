# --- Identifiants de l'application cTrader Open API ---------------------------
# A creer sur https://openapi.ctrader.com (espace developpeur > Applications).
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=

# URI de redirection OAuth. Elle doit etre declaree A L'IDENTIQUE dans la fiche
# de votre application cTrader, sinon l'autorisation est refusee.
#   local   : http://localhost:3000/api/ctrader/callback
#   Vercel  : https://<votre-domaine>/api/ctrader/callback
CTRADER_REDIRECT_URI=

# --- Optionnel ----------------------------------------------------------------
# Forcer le symbole or si votre broker le nomme autrement (XAUUSD.m, GOLD#, ...).
# Laisse vide, l'application le detecte automatiquement.
GOLD_SYMBOL=
