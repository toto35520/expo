<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>cAlgo.Robots</RootNamespace>
    <AssemblyName>GoldScalperPro</AssemblyName>
    <Product>Gold Scalper Pro</Product>
    <Version>2.0.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GoldScalperPro.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- cTrader 4.x / 5.x. If your cTrader still uses the old reference model,
         drop this ItemGroup and just paste GoldScalperPro.cs into the Automate editor. -->
    <PackageReference Include="cTrader.Automate" Version="1.*" />
  </ItemGroup>

</Project>
