# --- Obligatoire ---
# Mot de passe pour ouvrir ton app (choisis-en un long)
APP_PASSWORD=
# Chaîne aléatoire d'au moins 32 caractères (signe le cookie de connexion)
SESSION_SECRET=
# Clé API Anthropic (console.anthropic.com) pour les recommandations quotidiennes
ANTHROPIC_API_KEY=
# Secret que Vercel envoie à la tâche quotidienne (chaîne aléatoire)
CRON_SECRET=

# --- Base de données (ajoutée automatiquement par l'intégration Upstash de Vercel) ---
# L'app accepte l'un ou l'autre de ces couples de variables
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Optionnel ---
# Modèle Claude utilisé (par défaut claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
# Nombre maximum d'analyses IA lancées à la main par jour (par défaut 3)
# MAX_MANUAL_AI_RUNS=3
