# Identifiants cTrader Open API — copier en .env et NE JAMAIS COMMITER
# Creer une application sur https://openapi.ctrader.com/
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=

# demo | live  — commencez TOUJOURS par demo
CTRADER_ENV=demo

# Optionnel : sinon le premier compte correspondant a CTRADER_ENV est choisi
CTRADER_ACCOUNT_ID=

# Optionnel : chemin par defaut du CSV pour gs-backtest
GS_CSV=
