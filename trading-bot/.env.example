# --- Accès cTrader Open API (https://openapi.ctrader.com/apps) ---
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=https://spotware.com
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=          # ctidTraderAccountId affiché par get_token.py (≠ numéro de login)
CTRADER_ENV=demo             # demo | live  (doit correspondre au type du compte)

# --- Marché ---
SYMBOL=XAUUSD
TIMEFRAME=H1                 # M1 M5 M15 M30 H1 H4 D1

# --- Risque ---
RISK_PER_TRADE_PCT=0.5       # % du solde perdu si le stop est touché
MAX_DAILY_LOSS_PCT=2         # stop des nouvelles entrées au-delà de cette perte journalière
DRY_RUN=true                 # true = simulation, aucun ordre envoyé
BOT_LABEL=claude-bot         # le bot ne touche QUE les positions portant ce label

# --- Stratégie ---
EMA_FAST=20
EMA_SLOW=50
EMA_TREND=200
ATR_PERIOD=14
SL_ATR=2.0
TP_ATR=3.0
