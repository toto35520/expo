# Aucune variable n'est obligatoire.
#
# Par défaut, chaque utilisateur saisit sa propre clé gratuite dans l'app :
# elle reste dans le stockage local de son navigateur et n'est jamais
# enregistrée sur le serveur. C'est ce qui permet de déployer sur l'offre
# gratuite Vercel sans rien payer.
#
# Les variables ci-dessous ne servent que si tu préfères poser la clé une
# bonne fois pour toutes côté serveur (usage strictement personnel — toute
# personne ayant l'URL consommerait alors ton quota).

# GEMINI_API_KEY=AIza...          # https://aistudio.google.com/apikey
# GROQ_API_KEY=gsk_...            # https://console.groq.com/keys
# OPENROUTER_API_KEY=sk-or-...    # https://openrouter.ai/keys
